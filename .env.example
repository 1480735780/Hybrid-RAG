# =============================================================================
# Enterprise Ops Assistant - Environment Configuration
# =============================================================================

# Application
APP_NAME=Enterprise Ops Assistant
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=ops_assistant

# Vector Store (ChromaDB for development)
VECTOR_STORE_TYPE=chroma
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=ops_knowledge

# Vector Store (Milvus for production)
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=ops_knowledge

# Embedding Model
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# Rerank Model
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=cpu
RERANK_TOP_K=3

# LLM Configuration
# Options: openai, dashscope, local
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4-turbo

# DashScope Configuration (for Qwen/DeepSeek)
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_MODEL=qwen-max

# Local LLM Configuration
LOCAL_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LOCAL_LLM_DEVICE=auto

# BM25 Configuration
BM25_K1=1.5
BM25_B=0.75
BM25_TOP_K=20

# Retrieval Configuration
RETRIEVAL_TOP_K=20
RERANK_TOP_K=3
HYBRID_ALPHA=0.7

# Document Processing
CHUNK_SIZE=512
CHUNK_OVERLAP=50
MAX_FILE_SIZE_MB=50

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8501"]

# Redis (for caching and session)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
